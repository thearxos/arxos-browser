{
  "_comment": "ARXOS hardened + debloated Brave defaults (global managed policy). Kills Leo AI, Rewards, Wallet, VPN, crypto, news/shopping bloat, and all telemetry; keeps Tor + Shields. WebRtcIPHandling=disable_non_proxied_udp and DnsOverHttpsMode=off are load-bearing for anond: anond redirects traffic transparently (nftables), not via Brave's own proxy settings, so WebRTC UDP and Brave's built-in DoH would otherwise bypass anond's Tor routing/DNS pin entirely.",

  "BraveRewardsDisabled": true,
  "BraveWalletDisabled": true,
  "BraveVPNDisabled": true,
  "BraveAIChatEnabled": false,
  "BraveTalkDisabled": true,
  "TorDisabled": false,

  "MetricsReportingEnabled": false,
  "UrlKeyedAnonymizedDataCollectionEnabled": false,
  "CloudReportingEnabled": false,
  "FeedbackSurveysEnabled": false,
  "BackgroundModeEnabled": false,
  "PromotionalTabsEnabled": false,
  "MediaRecommendationsEnabled": false,
  "ShoppingListEnabled": false,
  "NTPCardsVisible": false,
  "NTPBackgroundImagesEnabled": false,
  "NTPCustomBackgroundEnabled": false,

  "BlockThirdPartyCookies": true,
  "DefaultCookiesSetting": 4,
  "SafeBrowsingProtectionLevel": 1,
  "SafeBrowsingExtendedReportingEnabled": false,
  "SafeBrowsingSurveysEnabled": false,
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "PaymentMethodQueryEnabled": false,
  "SearchSuggestEnabled": false,
  "AlternateErrorPagesEnabled": false,
  "SpellCheckServiceEnabled": false,

  "NetworkPredictionOptions": 2,
  "DnsOverHttpsMode": "off",
  "HttpsOnlyMode": "force_enabled",
  "WebRtcIPHandling": "disable_non_proxied_udp",
  "UserAgentReduction": 2,

  "HomepageLocation": "file:///usr/share/arxos/browser/welcome.html",
  "HomepageIsNewTabPage": false,
  "ShowHomeButton": true,
  "RestoreOnStartup": 4,
  "RestoreOnStartupURLs": ["file:///usr/share/arxos/browser/welcome.html"],

  "DefaultSearchProviderEnabled": true,
  "DefaultSearchProviderName": "DuckDuckGo",
  "DefaultSearchProviderSearchURL": "https://duckduckgo.com/?q={searchTerms}"
}
